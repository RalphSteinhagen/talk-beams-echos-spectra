  - id: gr::basic::StreamToDataSet<float32>
    parameters:
      name: mfSnapshot
      filter: RISING
      n_pre: 480
      n_post: 1440
      holdoff_samples: 24000
  - id: opendigitizer::ImPlotSink<gr::DataSet<float32>>
    parameters:
      name: mf
      signal_name: "matched filter, mic 1"
      dataset_index: 0
      signal_unit: a.u.
      n_history: 1
      color: 15921906
  - id: gr::blocks::trigger::SchmittTriggerNoInterpolation<float32>
    parameters:
      name: trigger # on the matched filter's output
      threshold: 0.2
      hysteresis: 0.04
      edge: rising
      dead_time: 24000
      trigger_name_rising: RISING
      sample_rate: 48000
  - id: opendigitizer::Arithmetic<float32>
    parameters:
      name: tagOnly # zero, carrying the trigger tag
      operation: "-"
  - id: gr::blocks::math::Add<float32, std::plus<float32>>
    parameters:
      name: tagged0
      n_inputs: 2
