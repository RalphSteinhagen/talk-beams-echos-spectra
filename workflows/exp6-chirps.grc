      n_history: 1
      color: 8755456
  - id: DigitizerUi::ImControlNumber
    parameters:
      name: threshold
      label: threshold
      unit: FS
      value: 0.2
      min: 0
      max: 1
      step: 0.01
      style: slider
      target_map: "trigger:threshold"
  - id: gr::blocks::trigger::LevelTrigger<float32>
    parameters:
      name: onset0 # mic 1's hits
      trigger_name: mic 1
      threshold: 0.15
      hysteresis: 0.075
      edge: rising
      dead_time: 24000.0
      dead_time_unit: samples
  - id: gr::blocks::trigger::LevelTrigger<float32>
    parameters:
      name: onset1 # mic 2's hits
      trigger_name: mic 2
      threshold: 0.15
      hysteresis: 0.075
      edge: rising
      dead_time: 24000.0
      dead_time_unit: samples
  - id: gr::blocks::trigger::LevelTrigger<float32>
    parameters:
      name: onset2 # mic 3's hits
      trigger_name: mic 3
      threshold: 0.15
      hysteresis: 0.075
      edge: rising
      dead_time: 24000.0
      dead_time_unit: samples
  - id: gr::blocks::trigger::LevelTrigger<float32>
    parameters:
      name: onset3 # mic 4's hits
      trigger_name: mic 4
      threshold: 0.15
      hysteresis: 0.075
      edge: rising
      dead_time: 24000.0
      dead_time_unit: samples
  - id: gr::blocks::trigger::MultiChannelRecorder<float32>
    parameters:
      name: window # all four channels around a hit
      n_inputs: 4
      n_pre: 480
      n_post: 2400
      retrigger: ignore
      holdoff: 0.5
      emit_partial: false
      history: 0.5
  - id: opendigitizer::localisation::DataSetToTensor<float32>
    parameters:
      name: frames
  - id: gr::localisation::PairCrossCorrelation<float32>
    parameters:
      name: correlation
      max_lag: 450
      weighting: none
      f_min: 100.0
      f_max: 10000.0
  - id: gr::localisation::PairDelay<float32>
    parameters:
      name: delays
      max_lag: 450
  - id: opendigitizer::localisation::PairDelayArrivals<float32>
    parameters:
      name: arrivals
      receiver_names: ["mic 1", "mic 2", "mic 3", "mic 4"]
      min_confidence: 2.0
  - id: opendigitizer::localisation::DelayLocator
    parameters:
      name: locator # the delays of one hit, solved for the drum
      receiver_names: ["mic 1", "mic 2", "mic 3", "mic 4"]
      element_positions: !!float64 [[-1.5, 0.0, 0.0], [-0.5, 0.0, 0.0], [0.5, 0.0, 0.0], [1.5, 0.0, 0.0]]
      roi: [-2.5, 2.5, -0.1, 5.0]
  - id: opendigitizer::ImPlotSink<gr::pmt::ValueMap>
    parameters:
      name: ranged
      signal_name: ranging
      color: 15921906
  - id: gr::blocks::fft::FFT<float32, gr::DataSet<float32>>
    parameters:
      name: FFT
      fft_size: 4096
      sample_rate: 48000
      output_in_db: true
      signal_name: mic 1 spectrum
  - id: opendigitizer::ImPlotSink<gr::DataSet<float32>>
    parameters:
      name: spectrum
      signal_name: mic 1 spectrum
      dataset_index: 0
      abscissa_quantity: frequency
      abscissa_unit: Hz
      signal_quantity: magnitude
      signal_unit: dB
connections:
  - [ chirp, 0, mix, [0, 0] ]
  - [ noise, 0, mix, [0, 1] ]
  - [ mix, 0, speaker, 0 ]
  - [ mics, [0, 0], matched, in ]
  - [ trigger, out, mfSnapshot, in ]
  - [ mfSnapshot, out, mf, in ]
  - [ matched, out, trigger, in ]
  - [ trigger, out, tagOnly, 0 ]
  - [ matched, out, tagOnly, 1 ]
  - [ mics, [0, 0], tagged0, [0, 0] ]
  - [ tagOnly, 0, tagged0, [0, 1] ]
  - [ mics, [0, 1], tagged1, [0, 0] ]
  - [ tagOnly, 0, tagged1, [0, 1] ]
  - [ mics, [0, 2], tagged2, [0, 0] ]
  - [ tagOnly, 0, tagged2, [0, 1] ]
  - [ mics, [0, 3], tagged3, [0, 0] ]
  - [ tagOnly, 0, tagged3, [0, 1] ]
  - [ tagged0, 0, lifted0, 0 ]
  - [ tagged1, 0, lifted1, 0 ]
  - [ tagged2, 0, lifted2, 0 ]
  - [ tagged3, 0, lifted3, 0 ]
  - [ lifted0, 0, snapshot0, in ]
  - [ snapshot0, out, mic1, in ]
  - [ lifted1, 0, snapshot1, in ]
  - [ snapshot1, out, mic2, in ]
  - [ lifted2, 0, snapshot2, in ]
  - [ snapshot2, out, mic3, in ]
  - [ lifted3, 0, snapshot3, in ]
  - [ snapshot3, out, mic4, in ]
  - [ mics, [0, 0], onset0, 0 ]
  - [ onset0, 0, window, 0 ]
  - [ mics, [0, 0], window, [1, 0] ]
  - [ mics, [0, 1], onset1, 0 ]
  - [ onset1, 0, window, 0 ]
  - [ mics, [0, 1], window, [1, 1] ]
  - [ mics, [0, 2], onset2, 0 ]
  - [ onset2, 0, window, 0 ]
  - [ mics, [0, 2], window, [1, 2] ]
  - [ mics, [0, 3], onset3, 0 ]
  - [ onset3, 0, window, 0 ]
  - [ mics, [0, 3], window, [1, 3] ]
  - [ window, 1, frames, 0 ]
  - [ frames, 0, correlation, 0 ]
  - [ correlation, 0, delays, 0 ]
  - [ delays, 0, arrivals, 0 ]
  - [ arrivals, 0, locator, 0 ]
  - [ arrivals, 0, ranged, 0 ]
  - [ locator, 0, ranged, 0 ]
  - [ mics, [0, 0], FFT, 0 ]
  - [ FFT, 0, spectrum, 0 ]
dashboard:
  layout: Free
  windowLayout:
    floatingWindows: { }
    dockSpace:
      hsplit:
        first:
          vsplit:
            first: "Ranging"
            second: "Under the picture"
            ratio: !!float32 0.44
        second:
          vsplit:
            first: "Four microphones, triggered on the matched filter"
            second:
              vsplit:
                first: "Matched filter, mic 1"
                second: "Waterfall, mic 1"
                ratio: !!float32 0.5
            ratio: !!float32 0.6667
        ratio: !!float32 0.3385
  sources:
    - name: mf
      block: mf
    - name: mic1
      block: mic1
    - name: mic2
      block: mic2
    - name: mic3
      block: mic3
    - name: mic4
      block: mic4
    - name: ranged
      block: ranged
    - name: spectrum
      block: spectrum
  plots:
    - name: Ranging
      type: opendigitizer::charts::LocalisationChart
      parameters:
        name: ranging # the `spacing` choice's target
        receiver_names: ["mic 1", "mic 2", "mic 3", "mic 4"]
        element_positions: !!float64 [[-1.5, 0.0, 0.0], [-0.5, 0.0, 0.0], [0.5, 0.0, 0.0], [1.5, 0.0, 0.0]]
        roi: [-2.5, 2.5, -0.1, 5.0]
        show_legend: false
        show_grid: false
        show_curve_labels: false # the drawn map beside it writes the delays
        show_status: true
      sources:
        - ranged
    - name: Under the picture
      type: XYChart
      parameters:
        show_legend: false
      axes:
        - axis: X
          min: 0
          max: 1
        - axis: Y
          min: 0
          max: 1
      sources: []
    - name: Four microphones, triggered on the matched filter
      type: XYChart
      parameters:
        show_legend: false
        show_tags: false
        n_history: 1920
        max_history_count: 1
      axes:
        - axis: X
          min: NaN
          max: NaN
        - axis: Y
          min: -1.4
          max: 1.4
      sources:
        - mic1
        - mic2
        - mic3
        - mic4
    - name: Matched filter, mic 1
      type: XYChart
      parameters:
        show_legend: false
        show_tags: false
        n_history: 1920
        max_history_count: 1
      axes:
        - axis: X
          min: NaN
          max: NaN
        - axis: Y
          min: -0.4
          max: 1.4
      sources:
        - mf
    - name: Waterfall, mic 1
      type: opendigitizer::charts::WaterfallPlot
      parameters:
        show_legend: false
        n_history: 59 # spectra: 5 s at 11.7 a second
        colormap: ImPlotColormap_Viridis
      axes:
        - axis: X
          min: 0
          max: 9700
          scale: Linear
          format: MetricInline
        - axis: Z
          min: -110
          max: -30
      sources:
        - spectrum
