# experiment 4 (slide `exp6`): the speaker plays a known chirp, 1-8 kHz in 20 ms, once a second; a noise slider buries it
# the matched filter (gr::filter::Correlator against the emitted chirp) compresses microphone 1's chirp to one
# 0.15 ms peak; the trigger watches that peak, so the snapshots keep coming when the chirp has vanished
# in the noise; the ranging left, the four snapshots, the matched filter's output and the waterfall right
blocks:
  - id: opendigitizer::video::BrowserMicrophonePairs
    parameters:
      name: mics # four microphones from two browser stereo sources (devtools/four-mics-browser-pairs.sh)
      pair_a: BEAMS_PAIR_A
      pair_b: BEAMS_PAIR_B
      sample_rate: 48000.0
      align: once
  - id: gr::blocks::fileio::WavSource<float32>
    parameters:
      name: chirp # the known waveform, 1-8 kHz in 20 ms, once a second
      uri: media/chirp-1-8khz.wav
      repeat: true
      trigger_name: ""
  - id: gr::basic::SignalGenerator<float32>
    parameters:
      name: noise # broadband, from the speaker: bury the chirp
      signal_type: GaussianNoise
      amplitude: 0
      sample_rate: 48000
      chunk_size: 480
  - id: gr::blocks::math::Add<float32, std::plus<float32>>
    parameters:
      name: mix
      n_inputs: 2
  - id: gr::audio::AudioSink<float32>
    parameters:
      name: speaker
      req_sample_rate: 48000
      n_inputs: 1
  - id: DigitizerUi::ImControlNumber
    parameters:
      name: noiseLevel
      label: noise
      unit: FS
      value: 0
      min: 0
      max: 0.5
      step: 0.01
      style: slider
      target_map: "noise:amplitude"
  - id: gr::filter::Correlator<float32>
    parameters:
      name: matched # microphone 1 against the emitted chirp: the matched filter
