    parameters:
      name: tagged3
      n_inputs: 2
  - id: gr::blocks::math::AddConst<float32, std::plus<float32>>
    parameters:
      name: lifted0 # the trace's lift
      value: 0.9
  - id: gr::blocks::math::AddConst<float32, std::plus<float32>>
    parameters:
      name: lifted1 # the trace's lift
      value: 0.3
  - id: gr::blocks::math::AddConst<float32, std::plus<float32>>
    parameters:
      name: lifted2 # the trace's lift
      value: -0.3
  - id: gr::blocks::math::AddConst<float32, std::plus<float32>>
    parameters:
      name: lifted3 # the trace's lift
      value: -0.9
  - id: gr::basic::StreamToDataSet<float32>
    parameters:
      name: snapshot0
      filter: RISING
      n_pre: 480
      n_post: 1440
      holdoff_samples: 24000
  - id: opendigitizer::ImPlotSink<gr::DataSet<float32>>
    parameters:
      name: mic1
      signal_name: mic 1
      dataset_index: 0
      signal_unit: FS
      n_history: 1
